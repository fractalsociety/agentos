/* AgentOS official Codex guest overlay; generated with the actual initrd end. */
/ {
    dma-coherent;

    /* Keep the base node name so dtscat replaces its 2 GiB reg property. */
    memory@40000000 {
        device_type = "memory";
        reg = <0x00 0x80000000 0x00 0x30000000>;
    };

    flash@0 {
        status = "disabled";
    };

    aliases {
        serial0 = "/pl011@9000000";
    };

    chosen {
        stdout-path = "serial0:115200n8";
        bootargs = "earlycon=pl011,0x9000000 console=ttyAMA0,115200n8 rdinit=/sbin/init panic=-1";
        linux,stdout-path = "serial0:115200n8";
        linux,initrd-start = <0x00 0x90000000>;
        linux,initrd-end = <0x00 @CODEX_INITRD_END@>;
    };
};
