#!/bin/sh
# PROVIDE: agentos_mesh_firstboot
# REQUIRE: NETWORKING
# BEFORE: headscale

. /etc/rc.subr
name="agentos_mesh_firstboot"
rcvar="agentos_mesh_firstboot_enable"
start_cmd="agentos_mesh_firstboot_start"

agentos_mesh_firstboot_start()
{
    marker=/var/db/agentos-mesh-controller.installed
    log=/var/log/agentos-mesh-firstboot.log
    [ -f "$marker" ] && return 0
    attempt=1
    installed=0
    while [ "$attempt" -le 3 ]; do
        if /usr/local/share/agentos/roles/mesh-controller/install.sh >>"$log" 2>&1; then
            installed=1
            break
        fi
        echo "attempt $attempt failed" >>"$log"
        attempt=$((attempt + 1))
        [ "$attempt" -gt 3 ] || sleep 5
    done
    if [ "$installed" -ne 1 ]; then
        logger -t agentos_mesh_firstboot "mesh-controller installation failed"
        return 1
    fi
    touch "$marker"
    sysrc agentos_mesh_firstboot_enable=NO >/dev/null
}

load_rc_config "$name"
: ${agentos_mesh_firstboot_enable:="NO"}
run_rc_command "$1"
