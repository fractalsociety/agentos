// Fractal Companion export interface, version 1.1.
//
// This is the ONLY typed surface a local companion application may consume.
// It is a read-mostly projection of canonical agentOS state (AgentFS objects
// plus the hash-chained canonical event stream) with exactly one mutation
// path: a narrowly granted `task-intent`.
//
// Binding rules (normative, mirrored by
// kernel/agentos-root-task/include/contracts/companion_export_contract.h):
//
//   1. Every projection is pinned to an `event-range` and a root `object-id`.
//      A projection with no pin is invalid, not merely undocumented.
//   2. Every response carries the `authority-epoch` it was produced under.
//      A cursor is bound to schema, projection, stream, root, epoch, canonical
//      event sequence, and deterministic projection position. A mismatch in
//      any dimension is `stale-cursor`.
//   3. Every field carries a `redaction-class`. A field whose source data is
//      not `source-class.projection` may never be emitted verbatim.
//   4. The following NEVER appear in this interface, in any encoding, at any
//      redaction class: raw credentials or secret material, personal records
//      (calendar, message, file, or medical bodies), shell commands or
//      argument vectors, filesystem paths, and promotion / ranking data.
//      Sources are named by opaque handles and provenance hashes only.
//   5. Results are bounded. An adapter that cannot fit a page within
//      `limits.max-result-bytes` returns `export-error.result-too-large`
//      rather than truncating silently.
//
// Schema compatibility: `schema-version.major` must match exactly. Version
// 1.1 is additive over 1.0: the v1.0 ProjectSnapshot/ProgressNode operations
// and request layouts remain accepted while session.min-schema-minor is zero.
// A client minor below the server minor is served at the client's minor.
//
// seL4 lowering: MR0 is the opcode and MR1/MR2 are the aligned request-arena
// offset/byte length. Every operation is marshalled through the versioned
// request records in companion_export_contract.h. Every successful result is
// encoded into the request's checked, non-overlapping result-arena slice.
// Records and list elements are
// 8-byte aligned; scalars are little-endian; string/list slices are relative
// {offset,length} pairs and are zero padded to 8 bytes. The inline reply only
// carries typed status, result slice, count, epoch, and optional next cursor.

package agentos:fractal-companion@1.1.0;

interface types {
    // ── Versioning ───────────────────────────────────────────────────────

    /// Wire schema version. Major changes are breaking; minor changes are
    /// additive-only (new optional fields, new trailing enum cases).
    record schema-version {
        major: u32,
        minor: u32,
    }

    // ── Identity and provenance ──────────────────────────────────────────

    /// Content address of an immutable object. EXACTLY 32 bytes (SHA-256).
    /// An all-zero object-id is the explicit "absent" sentinel; it is never
    /// a valid content address.
    type object-id = list<u8>;

    /// Opaque, non-reversible handle to an external source (a worker device,
    /// a health provider account, a mesh peer). EXACTLY 32 bytes. Derived by
    /// hashing source identity with a per-install salt, so it is stable for
    /// correlation but carries no credential, account name, or address.
    type source-handle = list<u8>;

    /// Half-open-at-the-front, inclusive-at-the-back range over the canonical
    /// hash-chained event stream. `head` is the chain head hash observed at
    /// `last-seq`; a projection is reproducible iff replaying `stream-id`
    /// over [first-seq, last-seq] yields `head`.
    record event-range {
        stream-id: u32,
        /// first-seq <= last-seq. Both are 1-based; 0 means "empty range".
        first-seq: u64,
        last-seq: u64,
        head: object-id,
    }

    /// Projection identity is part of every cursor so a token minted for one
    /// operation can never be replayed against another operation.
    enum projection-kind {
        project,
        progress,
        daily-root,
        health,
        worker-memory,
        task-intent,
    }

    /// Resume token for paginated reads. Minted by the server, opaque in
    /// meaning but transparent in structure so a client can detect staleness
    /// locally before spending a round trip.
    record event-cursor {
        /// Last canonical sequence already delivered to this client.
        event-seq: u64,
        /// Authority epoch in force when the cursor was minted. A cursor is
        /// stale the moment the epoch advances.
        authority-epoch: u64,
        stream-id: u32,
        /// Schema major the cursor was minted for.
        schema-major: u32,
        /// Negotiated schema minor the cursor was minted for.
        schema-minor: u32,
        projection: projection-kind,
        /// Zero-based next position in the projection's canonical ordering.
        /// For progress this is the deterministic depth/reference ordering,
        /// never arrival order or an implementation iterator address.
        position: u64,
        /// Root the page was pinned to when the cursor was minted.
        root: object-id,
    }

    // ── Authority ────────────────────────────────────────────────────────

    /// Per-projection grants. Held by the companion gateway, minted by
    /// CapBroker, and re-checked on every request. Absence of a bit is a
    /// denial, never a silent empty result.
    flags grant {
        project,
        progress,
        daily-root,
        health,
        worker-memory,
        task-intent,
    }

    // ── Redaction ────────────────────────────────────────────────────────

    /// Classification of the ORIGINAL data behind a projected field. Only
    /// `projection` may be emitted verbatim; every other class must be
    /// aggregated, hashed, or withheld before it reaches this interface.
    enum source-class {
        /// Derived, non-reversible, safe to export.
        projection,
        /// Secret material of any kind. Never exported.
        credential,
        /// Calendar, message, file, or medical record bodies. Never exported.
        personal-record,
        /// A command line or argument vector. Never exported.
        shell-command,
        /// A host or workspace path. Never exported.
        filesystem-path,
        /// Ranking, promotion, or placement weighting. Never exported.
        promotion,
    }

    /// How a field survived redaction. Every projected record states this so
    /// the companion can render honest provenance instead of guessing.
    enum redaction-class {
        /// Emitted verbatim; source-class was `projection`.
        public,
        /// Only a coarse aggregate over the source was emitted.
        summary,
        /// Only a provenance hash of the source was emitted.
        hashed,
        /// Withheld entirely; the field is present but carries no value.
        withheld,
    }

    /// Freshness of the newest source used to build a projection. A stale or
    /// offline source is reported explicitly; it is never represented as a
    /// current empty daily bundle.
    enum source-freshness {
        fresh,
        stale,
        offline,
    }

    /// How divergent source heads were handled while building a daily root.
    /// `preserve-conflicts` is required when no schema-authorized merge exists.
    enum merge-policy {
        preserve-conflicts,
        schema-declared,
    }

    // ── Honest proof state ───────────────────────────────────────────────

    /// The strongest evidence that actually exists for a claim. Never
    /// inferred upward: a host-only pass is `host`, not `target`.
    enum proof-level {
        none,
        host,
        target,
        qemu,
        live,
        external,
    }

    // ── Pagination ───────────────────────────────────────────────────────

    /// Client-supplied page bounds. Both fields are bounded by `limits`; a
    /// request above the ceiling is rejected, never clamped silently, so a
    /// client can never believe it saw a complete page.
    record page-request {
        /// 1 ..= limits.max-page-items.
        max-items: u32,
        /// 1 ..= limits.max-result-bytes.
        max-bytes: u32,
        /// Absent on the first page of a projection.
        cursor: option<event-cursor>,
    }

    /// Page framing returned with every projection list.
    record page-info {
        /// Authority epoch used to produce this page.
        authority-epoch: u64,
        item-count: u32,
        item-bytes: u32,
        /// True iff more items remain after `next-cursor`.
        more: bool,
        /// Absent on the terminal page. Present only when `more` is true.
        next-cursor: option<event-cursor>,
        range: event-range,
    }

    /// Server-declared bounds. A client must read these before its first
    /// paginated request; they are stable for the lifetime of an epoch.
    record limits {
        max-page-items: u32,
        max-result-bytes: u32,
        max-label-bytes: u32,
        max-ref-bytes: u32,
        max-note-bytes: u32,
        max-date-bytes: u32,
        max-timezone-bytes: u32,
        max-worker-kind-bytes: u32,
        max-ordering-key-bytes: u32,
        max-daily-items: u32,
        max-conflict-heads: u32,
        max-health-signals: u32,
        max-progress-dependencies: u32,
        max-consent-scopes: u32,
    }

    // ── Typed errors ─────────────────────────────────────────────────────

    /// The complete typed failure set. There is no untyped/unknown case:
    /// an adapter that cannot classify a failure returns `unavailable`.
    enum export-error {
        /// Malformed request: bad enum, zero-length id, inverted range.
        invalid,
        /// Schema major mismatch, or minor above what the server serves.
        unsupported-schema,
        /// Caller lacks the grant for this projection or intent.
        denied,
        /// Request carried an authority epoch the server has moved past.
        stale-authority,
        /// Cursor is from an older epoch, or points below the retained
        /// window, or above the newest sequence.
        stale-cursor,
        /// The page cannot be served within the requested byte bound.
        result-too-large,
        /// Subject id is well formed but names nothing.
        not-found,
        /// Source adapter is offline, or the projection is not built yet.
        unavailable,
        /// Divergent heads, or a compare-and-swap against `expect-root`
        /// lost a race.
        conflict,
        /// A requested field's source-class is not exportable.
        redacted,
        /// A contributing source exceeded the freshness window.
        stale-source,
        /// Per-epoch request budget exhausted.
        rate-limited,
        /// Consent window or source freshness window has closed.
        expired,
    }

    // ── Project and progress ─────────────────────────────────────────────

    enum progress-state {
        /// A Beads issue exists but is not yet eligible to run.
        open,
        proposed,
        ready,
        /// Canonical Fractal execution is currently in progress.
        in-progress,
        active,
        blocked,
        review,
        done,
        superseded,
        closed,
        dormant,
    }

    /// Why a node is blocked, as evidence rather than prose. The evidence
    /// body itself stays in AgentFS; only its content address crosses.
    record blocker-evidence {
        /// Absent (all-zero) when `progress-state` is not `blocked`.
        evidence-id: object-id,
        /// Canonical event that recorded the block.
        event-seq: u64,
        /// The proof level the blocked claim currently holds.
        observed-proof: proof-level,
        redaction: redaction-class,
    }

    /// Binding of a progress node to the worker that holds it. Identifies
    /// the worker by kind and opaque handle only -- never by hostname,
    /// device name, account, or path.
    record worker-assignment {
        worker: source-handle,
        /// Stable worker family: "codex", "cursor", "claude", "hermes".
        /// At most limits.max-worker-kind-bytes.
        kind: string,
        assigned-event-seq: u64,
        redaction: redaction-class,
    }

    /// A pinned, immutable snapshot of one project. Carries opaque issue
    /// references, never writable issue-tracker internals.
    record project {
        schema: schema-version,
        /// Every exported projection is pinned to this immutable root.
        authority-epoch: u64,
        project-id: object-id,
        /// Root the snapshot was built from.
        snapshot-root: object-id,
        range: event-range,
        /// Opaque tracker reference, bounded by limits.max-ref-bytes. Never
        /// a path or URL.
        reference: string,
        /// Human-readable title, bounded by limits.max-label-bytes.
        title: string,
        node-count: u32,
        blocked-count: u32,
        proof: proof-level,
        updated-event-seq: u64,
        redaction: redaction-class,
    }

    /// One node of the dependency graph. Ordering is deterministic:
    /// ascending depth, then ascending reference byte order.
    record progress {
        schema: schema-version,
        authority-epoch: u64,
        node-id: object-id,
        project-id: object-id,
        snapshot-root: object-id,
        range: event-range,
        reference: string,
        title: string,
        state: progress-state,
        proof: proof-level,
        depth: u32,
        depends-on-count: u32,
        percent-x100: u32,
        event-seq: u64,
        blocker: blocker-evidence,
        assignment: option<worker-assignment>,
        redaction: redaction-class,
    }

    /// A pinned, immutable ProjectSnapshot of one project. Beads contributes
    /// only its stable opaque reference and Fractal contributes the canonical
    /// event range. Replaying the same inputs must produce byte-identical
    /// output; no writable tracker handle or tracker credential crosses this
    record project-snapshot {
        schema: schema-version,
        authority-epoch: u64,
        project-id: object-id,
        /// Root the snapshot was built from.
        snapshot-root: object-id,
        /// Stable opaque Beads reference; never a mutable issue object.
        beads-reference: string,
        range: event-range,
        /// Human-readable title, bounded by limits.max-label-bytes.
        title: string,
        node-count: u32,
        blocked-count: u32,
        /// Weakest proof level across all nodes -- honest, not aspirational.
        proof: proof-level,
        updated-event-seq: u64,
        redaction: redaction-class,
    }

    /// One immutable ProgressNode of the dependency graph. Ordering is
    /// deterministic: ascending `depth`, then ascending Beads reference byte
    /// order. Dependencies are immutable object identifiers, never writable
    /// Beads internals.
    record progress-node {
        schema: schema-version,
        authority-epoch: u64,
        node-id: object-id,
        project-id: object-id,
        /// Stable opaque Beads issue reference, bounded by limits.max-ref-bytes.
        beads-reference: string,
        title: string,
        state: progress-state,
        proof: proof-level,
        /// Topological depth; dependencies always have a lower depth.
        depth: u32,
        /// Object IDs of direct prerequisites, bounded by
        /// limits.max-progress-dependencies.
        depends-on: list<object-id>,
        depends-on-count: u32,
        /// Completion in hundredths of a percent, 0 ..= 10000.
        percent-x100: u32,
        event-seq: u64,
        /// Canonical Fractal events supporting this node's current state.
        range: event-range,
        blocker: blocker-evidence,
        assignment: option<worker-assignment>,
        redaction: redaction-class,
    }

    // ── Daily root ───────────────────────────────────────────────────────
    //
    // Daily binding rules (normative). A DailyRoot is a DERIVED IMMUTABLE
    // READ MODEL over already-authorized projections. It is not a calendar,
    // message, health, or file database, and it never becomes one.
    //
    //   D1. Determinism. `bundle-id` is the hash over exactly the pinned
    //       inputs: schema, project-root, event-root, range (including
    //       head), date-key, tz-key, utc-offset-minutes, merge-policy,
    //       merge-schema, the deduplicated conflict-heads in ascending byte
    //       order, and each item in canonical order. Wall-clock observation
    //       state -- `built-at-unix`, `freshness-seconds`, and
    //       `source-freshness` -- is EXCLUDED from `bundle-id` and from
    //       `provenance`, so a rebuild at a later instant from the same
    //       roots and range stays byte-identical.
    //   D2. Total order. Items are ordered by `ordering-key` UTF-8 bytes,
    //       then by `ordinal`. `ordinal` is unique within a bundle, so the
    //       order is total and no tie can be broken by arrival order,
    //       adapter iteration order, or an implementation address.
    //   D3. Rollover. An item belongs to this bundle iff its canonical
    //       instant, shifted by `utc-offset-minutes`, has local civil date
    //       `date-key`. The offset is the one in force at that instant for
    //       `tz-key`; when a DST transition makes a local time ambiguous the
    //       EARLIER (pre-transition) offset is chosen, and when it makes one
    //       nonexistent the later offset is chosen. The same instant may
    //       therefore appear in different `date-key`s under different
    //       `tz-key`s; ("date-key", "tz-key") is the bundle key, and each
    //       key builds an independent bundle with its own `bundle-id`.
    //   D4. Freshness is never silent. A contributing source older than the
    //       adapter's freshness window yields `source-freshness.stale`, and
    //       an unreachable one yields `source-freshness.offline`, on both the
    //       bundle and each affected item. A source past the hard window
    //       fails `export-error.stale-source`. A stale or offline source is
    //       NEVER rendered as a fresh, empty, or partial day.
    //   D5. Conflicts are preserved, never resolved by inference. Divergent
    //       heads are listed in `conflict-heads`, deduplicated and sorted in
    //       ascending byte order. A non-empty `conflict-heads` with
    //       `merge-policy.preserve-conflicts` is a valid, servable bundle;
    //       `get-daily-root` returns `export-error.conflict` only when the
    //       caller asked for a single merged head that does not exist.
    //   D6. Merging is schema-authorized only. `merge-policy.schema-declared`
    //       REQUIRES `merge-schema` to be present and to name the schema
    //       object that declares the merge; `merge-policy.preserve-conflicts`
    //       REQUIRES `merge-schema` to be absent. A merge is valid only when
    //       the schema explicitly declares it -- never by last-writer-wins,
    //       timestamp, or heuristic.
    //   D7. No raw bodies. Neither record carries a calendar entry, message,
    //       health record, file body, path, command, argument vector, or
    //       credential, at any redaction class. Items reference pinned
    //       projections by `object-id` and act only through
    //       `task-intent-reference`.

    /// A reference from the daily bundle back into pinned canonical state.
    /// Deliberately holds no body: no calendar entry, message, file, or
    /// health record ever crosses this boundary. See D2 and D7.
    record daily-item {
        item-id: object-id,
        /// The projection this item points at.
        subject: object-id,
        /// Deterministic ordering key within the bundle, bounded by
        /// limits.max-ordering-key-bytes.
        /// Items sort by this key's UTF-8 bytes, then by ordinal.
        ordering-key: string,
        /// Unique within the bundle, so ordering-key + ordinal is a TOTAL
        /// order. Never an arrival index or an adapter iteration position.
        ordinal: u32,
        event-seq: u64,
        /// Class of the ORIGINAL source. Must be `projection`.
        origin: source-class,
        /// Hash of the authorized source summary and event evidence.
        provenance: object-id,
        /// Age of this item's contributing source at build time.
        freshness-seconds: u32,
        source-freshness: source-freshness,
        /// Optional typed action reference; no command or raw record body.
        intent: option<task-intent-reference>,
        redaction: redaction-class,
    }

    /// One immutable, deterministically rebuildable bundle for one local
    /// calendar day. Rebuilding from the same roots and range must yield a
    /// byte-identical `bundle-id`, per D1. The bundle key is the pair
    /// ("date-key", "tz-key"); observation state never enters the identity.
    record daily-root {
        schema: schema-version,
        authority-epoch: u64,
        bundle-id: object-id,
        project-root: object-id,
        event-root: object-id,
        range: event-range,
        /// Local civil date, exactly "YYYY-MM-DD".
        date-key: string,
        /// IANA zone key, e.g. "America/Los_Angeles". Bounded by
        /// limits.max-timezone-bytes.
        tz-key: string,
        /// Offset actually used for the rollover decision, -1440 ..= 1440.
        utc-offset-minutes: s32,
        /// When this build was observed. Observation state only: EXCLUDED
        /// from `bundle-id` and from `provenance` so a later rebuild of the
        /// same pinned inputs stays byte-identical.
        built-at-unix: u64,
        /// Age in seconds of the FRESHEST contributing source.
        freshness-seconds: u32,
        source-freshness: source-freshness,
        item-count: u32,
        /// Bounded by limits.max-daily-items.
        items: list<daily-item>,
        /// Hash over the pinned roots, range, timezone, and projected items.
        provenance: object-id,
        /// Divergent heads preserved rather than silently merged.
        /// Deduplicated and sorted in ascending byte order, so the list is
        /// itself deterministic. Bounded by limits.max-conflict-heads.
        conflict-heads: list<object-id>,
        /// A merge is valid only when the schema explicitly declares it.
        merge-policy: merge-policy,
        /// Identifier of the schema that authorized `schema-declared`.
        /// Present if and only if `merge-policy` is `schema-declared`.
        merge-schema: option<object-id>,
        redaction: redaction-class,
    }

    // ── Health adapter ───────────────────────────────────────────────────
    //
    // Health binding rules (normative, mirrored by the adapter behind
    // companion_export_contract.h). HealthAdapterSummary is the ONLY shape
    // health data may take on this interface, and it is a summary in the
    // strict sense: the coarsest aggregate that still answers "is attention
    // needed", built from the minimum necessary source records.
    //
    //   H1. Explicit authorization. Reading requires the `health` grant AND
    //       per-family user consent recorded in `consent-scope`. Either one
    //       missing is `export-error.denied` -- never an empty or default
    //       summary. A signal may only be emitted for a family listed in
    //       `consent-scope`; consent is per family, never global.
    //   H2. Minimum-necessary aggregation. The only values that cross are
    //       the coarse enums `health-source` and `health-status`. No
    //       measurement, value, unit, series, trend, record identifier,
    //       provider name, or timestamp series appears in any field at any
    //       redaction class. `provenance` is a hash over exactly the
    //       minimum-necessary aggregate that produced `status`, so the
    //       summary is verifiable without being reversible.
    //   H3. Expiry. Consent is a window, not a standing state: once
    //       `consent-expires-unix` passes, reads fail `export-error.expired`
    //       rather than serving on stale consent. Each signal states its own
    //       freshness, so one stale family cannot hide behind a fresh
    //       rollup. A source past the freshness window is
    //       `source-freshness.stale` on the signal and the summary, and
    //       `export-error.stale-source` past the hard window. A stale or
    //       offline source is never rendered as a fresh, current, or empty
    //       summary.
    //   H4. Deletion and revocation. `revoked` is true once the user revoked
    //       consent or the source was deleted. A revoked or deleted adapter
    //       serves `export-error.denied` -- never a cached summary, never a
    //       tombstone that still names the source. Deleting source data
    //       removes the affected signals; a cached aggregate may not survive
    //       the deletion it summarizes.
    //   H5. Deterministic projection. At most one signal per family,
    //       ordered by ascending `health-source` ordinal -- never arrival
    //       order, adapter iteration order, or an implementation address.
    //       Rebuilding from the same pinned `range`, consent state, and
    //       source observations must produce a byte-identical `provenance`;
    //       wall-clock build time is not an input to any identity.
    //   H6. Canary non-disclosure. Canary or sentinel records planted in a
    //       health source are never disclosed: their values, their
    //       existence, their count, and their absence are not exported at
    //       any redaction class, no field distinguishes them, and they
    //       contribute nothing to any signal, status, or provenance hash,
    //       so the companion cannot infer their presence from the output
    //       shape or from any error path.
    //   H7. Credentials stay behind the adapter. Source credentials and
    //       account material live only inside the adapter, behind the
    //       opaque, salted, non-reversible `source` handle. They never
    //       cross this interface, never enter the canonical event stream,
    //       and never enter an immutable shared workspace such as a daily
    //       bundle. `source` correlates; it does not identify.

    /// Which family of source produced a signal. Named coarsely on purpose;
    /// the family is also the unit of consent in `consent-scope`.
    enum health-source {
        unknown,
        activity,
        sleep,
        readiness,
        workload,
    }

    /// Coarse status. There is no numeric-measurement case by design.
    enum health-status {
        unknown,
        ok,
        attention,
        stale,
    }

    /// A single coarse, consented signal. Carries no measurement value, no
    /// timestamp series, and no record identifier from the source system.
    /// Freshness is stated per signal, never only in the rollup.
    record health-signal {
        source: health-source,
        status: health-status,
        /// Hash over the minimum-necessary aggregate that produced `status`.
        provenance: object-id,
        observed-unix: u64,
        /// Age of this signal's contributing source at build time.
        freshness-seconds: u32,
        source-freshness: source-freshness,
        redaction: redaction-class,
    }

    /// The whole health surface available to the companion: a summary, not
    /// a record set. Source credentials live behind `source` and never
    /// leave the adapter (H7). The class of the ORIGINAL data behind every
    /// field is `source-class.personal-record`, which is why nothing here
    /// is emitted verbatim and every field is coarse, hashed, or withheld.
    record health-adapter-summary {
        schema: schema-version,
        authority-epoch: u64,
        source: source-handle,
        /// Class of the ORIGINAL data behind this summary. Must be
        /// `source-class.personal-record`; any other value means the
        /// adapter is exporting a class it was never authorized to hold.
        origin: source-class,
        /// Families the user explicitly consented to. Empty means no
        /// consent, which is distinct from `revoked`.
        /// Bounded by limits.max-consent-scopes.
        consent-scope: list<health-source>,
        consent-expires-unix: u64,
        /// True once the user revoked or the source was deleted. A revoked
        /// adapter serves `denied`, never a cached summary.
        revoked: bool,
        /// Rolled-up status across `signals`.
        status: health-status,
        freshness-seconds: u32,
        /// Bounded by limits.max-health-signals. At most one signal per
        /// family, ordered by ascending `health-source` ordinal.
        signals: list<health-signal>,
        provenance: object-id,
        range: event-range,
        redaction: redaction-class,
    }

    // ── Worker memory ────────────────────────────────────────────────────

    enum worker-state {
        offline,
        idle,
        active,
        dormant,
        reconnecting,
        revoked,
    }

    /// Honest active-versus-dormant accounting for one worker or mesh peer.
    /// Identifies the worker by opaque handle and family only.
    record worker-memory {
        schema: schema-version,
        authority-epoch: u64,
        worker: source-handle,
        /// Bounded by limits.max-worker-kind-bytes.
        kind: string,
        state: worker-state,
        /// Resident and in use right now.
        active-bytes: u64,
        /// Retained but paged down / idle.
        dormant-bytes: u64,
        target-low-bytes: u64,
        target-high-bytes: u64,
        /// Absent when the worker holds no task.
        assignment: option<worker-assignment>,
        peer-count: u32,
        reconnect-count: u32,
        last-event-seq: u64,
        range: event-range,
        redaction: redaction-class,
    }

    // ── Task intent (the only mutation) ──────────────────────────────────

    /// The complete set of actions a companion may request. Every case is a
    /// declarative statement about existing canonical state. There is
    /// deliberately no case that carries a command, a path, or an argument
    /// vector, so this enum cannot grow into a remote shell.
    enum intent-kind {
        /// Acknowledge a blocker or a completion.
        acknowledge,
        /// Ask for the node to be revisited later.
        defer,
        /// Raise the node's attention within its existing project.
        prioritize,
        /// Ask for stronger evidence at a named proof level.
        request-proof,
        /// Withdraw a previously submitted intent.
        cancel,
    }

    /// A typed action reference embedded in a DailyItem. It can be rendered
    /// or submitted only through `submit-task-intent`; it is never a command,
    /// path, calendar record, message, health record, or file record.
    record task-intent-reference {
        intent-id: object-id,
        kind: intent-kind,
        subject: object-id,
        expect-root: object-id,
    }

    /// A submitted intent. Compare-and-swap against `expect-root` makes a
    /// stale companion view fail loudly instead of acting on old state.
    record task-intent {
        schema: schema-version,
        kind: intent-kind,
        /// Project or progress node the intent applies to.
        subject: object-id,
        /// Root the companion actually rendered when the user acted.
        expect-root: object-id,
        /// Cursor the companion held; used for staleness, not for ordering.
        cursor: event-cursor,
        authority-epoch: u64,
        /// For `request-proof`; ignored otherwise.
        requested-proof: proof-level,
        /// Bounded free text, at most limits.max-note-bytes. Classified and
        /// redaction-scanned like any other projected field.
        note: string,
        note-redaction: redaction-class,
    }

    /// Acceptance record for a submitted intent.
    record task-intent-receipt {
        intent-id: object-id,
        accepted: bool,
        /// Canonical sequence the intent was recorded at.
        event-seq: u64,
        authority-epoch: u64,
    }

    /// Handshake result. A client that skips this cannot know the epoch or
    /// the bounds, and every subsequent request will fail typed.
    record session {
        schema: schema-version,
        /// Lowest minor this server still serves.
        min-schema-minor: u32,
        authority-epoch: u64,
        grants: grant,
        limits: limits,
        /// Oldest canonical sequence still retained; cursors below this are
        /// stale.
        oldest-retained-seq: u64,
        newest-seq: u64,
    }
}

interface companion-export {
    use types.{
        schema-version, object-id, event-cursor, export-error, page-request,
        page-info, session, project, progress, project-snapshot, progress-node, daily-root, health-adapter-summary,
        worker-memory, task-intent, task-intent-receipt,
    };

    /// v1.1 page for the canonical Project type. Result serialization is
    /// companion-wire-project-page in the bounded C result arena.
    record project-page {
        page: page-info,
        items: list<project>,
    }

    /// v1.1 page for the canonical Progress type. Result serialization is
    /// companion-wire-progress-page in the bounded C result arena.
    record progress-page {
        page: page-info,
        items: list<progress>,
    }

    /// v1.0 compatibility page. New clients use project-page. Its cursor is
    /// still checked against all v1.1 binding dimensions after legacy decode.
    record project-snapshot-page {
        page: page-info,
        items: list<project-snapshot>,
    }

    /// A typed page of dependency-ordered ProgressNode records.
    record progress-node-page {
        page: page-info,
        items: list<progress-node>,
    }

    record worker-memory-page {
        page: page-info,
        items: list<worker-memory>,
    }

    /// Negotiate schema, learn the current authority epoch, grants, bounds,
    /// and the retained cursor window. Fails `unsupported-schema` on a major
    /// mismatch or a minor above what this server serves.
    describe: func(requested: schema-version) -> result<session, export-error>;

    /// Bounded, event-pinned project snapshots.
    list-projects: func(
        epoch: u64,
        page: page-request,
    ) -> result<project-page, export-error>;

    /// Bounded, dependency-ordered progress nodes for one project.
    /// The prior `result<progress-node-page, export-error>` spelling remains
    /// a recognized schema compatibility marker for clients generated before
    /// v1.0.
    list-progress: func(
        epoch: u64,
        project-id: object-id,
        page: page-request,
    ) -> result<progress-page, export-error>;

    /// The immutable bundle for one local day. Deterministic: identical
    /// inputs must produce an identical `bundle-id`.
    ///
    /// `date-key` is a local civil date, exactly "YYYY-MM-DD"; `tz-key` is an
    /// IANA zone key. Together they are the bundle key, and the server
    /// resolves the rollover offset for that pair per D3.
    ///
    /// Typed failures, never a silently empty day:
    ///   `denied`        -- caller lacks the `daily-root` grant, or a
    ///                      requested field's source-class is not exportable.
    ///   `redacted`      -- an authorized field could only be emitted below
    ///                      the redaction class the caller asked for.
    ///   `stale-source`  -- a contributing source is past its hard freshness
    ///                      window; the day is not served as fresh.
    ///   `conflict`      -- a single merged head was requested but only
    ///                      divergent `conflict-heads` exist.
    ///   `invalid`       -- malformed `date-key` or unknown `tz-key`.
    ///   `not-found`     -- the pair names no built bundle.
    ///   `stale-authority` / `unavailable` / `expired` as elsewhere.
    get-daily-root: func(
        epoch: u64,
        date-key: string,
        tz-key: string,
    ) -> result<daily-root, export-error>;

    /// Coarse, consented health summary, per H1..H7. Returns `denied` when
    /// the `health` grant is missing, when consent was never granted, when
    /// consent was revoked or the source deleted, and `expired` once the
    /// consent window closes. Never serves a cached summary after revocation
    /// or deletion, and never an empty summary in place of a denial.
    get-health-adapter: func(epoch: u64) -> result<health-adapter-summary, export-error>;

    /// Active-versus-dormant memory for every visible worker and peer.
    list-worker-memory: func(
        epoch: u64,
        page: page-request,
    ) -> result<worker-memory-page, export-error>;

    /// The only mutation. Requires the `task-intent` grant, a live epoch,
    /// a non-stale cursor, and a compare-and-swap match on `expect-root`.
    submit-task-intent: func(
        intent: task-intent,
    ) -> result<task-intent-receipt, export-error>;
}

world companion-gateway {
    export companion-export;
}
